(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language pick up the butter and place it in the basket)
    (:regions
      (basket_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (butter_region
          (:target floor)
          (:ranges (
              (-0.14 -0.26 -0.10 -0.22)
            )
          )
      )
      (other_region_0
          (:target floor)
          (:ranges (
              (0.03 -0.12 0.07 -0.08)
            )
          )
      )
      (other_region_1
          (:target floor)
          (:ranges (
              (-0.22 -0.05 -0.18 -0.01)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    butter_1 - butter
    basket_1 - basket
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    butter_1
    basket_1
  )

  (:init
    (On butter_1 floor_butter_region)
    (On ketchup_1 floor_other_region_0)
    (On tomato_sauce_1 floor_other_region_1)
    (On basket_1 floor_basket_region)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )
)
