(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the round nut and place it on the plate)
    (:regions
      (nut_init_region
          (:target main_table)
          (:ranges (
              (-0.15 -0.05 -0.11 -0.01)
            )
          )
          (:yaw_rotation (
              (0.0 6.283)
            )
          )
      )
      (plate_region
          (:target main_table)
          (:ranges (
              (0.10 0.15 0.14 0.19)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    robosuite_round_nut_1 - robosuite_round_nut
    plate_1 - plate
  )

  (:obj_of_interest
    robosuite_round_nut_1
    plate_1
  )

  (:init
    (On robosuite_round_nut_1 main_table_nut_init_region)
    (On plate_1 main_table_plate_region)
  )

  (:goal
    (And (On robosuite_round_nut_1 plate_1))
  )
)
